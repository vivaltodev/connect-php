{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "vivaltodev/connect-php",
    "description": "PHP SDK for the Vivalto Connect API: SMS, PDF, images and webhooks",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "sms",
        "pdf",
        "document",
        "vivalto",
        "api",
        "sdk"
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "illuminate/config": "^11.0 || ^12.0",
        "illuminate/container": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "laravel/pint": "^1.13",
        "pestphp/pest": "^3.0",
        "phpoption/phpoption": "^1.10",
        "phpstan/phpstan": "^2.1",
        "vlucas/phpdotenv": "^5.8"
    },
    "suggest": {
        "illuminate/support": "Required for the optional Laravel service provider and facade."
    },
    "autoload": {
        "psr-4": {
            "Vivalto\\Connect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vivalto\\Connect\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Vivalto\\Connect\\Laravel\\VivaltoConnectServiceProvider"
            ],
            "aliases": {
                "VivaltoConnect": "Vivalto\\Connect\\Laravel\\Facades\\VivaltoConnect"
            }
        }
    }
}
